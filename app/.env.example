# .env.example — 새 개발자가 이 파일을 .env로 복사해서 값만 채우면 됩니다
# Supabase 대시보드 > Project Settings > API 에서 확인 가능
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# OAuth 로그인 후 돌아올 사이트 절대 URL (scheme 포함 필수 — 없으면 리다이렉트가 깨짐)
VITE_SITE_URL=https://gongzip.developerlog.xyz
